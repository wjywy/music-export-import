# ── Database (MySQL 8) ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dukou
DB_PASSWORD=dukou
DB_NAME=dukou

# ── App ─────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Encrypts per-user platform tokens (Apple Music). Falls back to JWT_SECRET if empty.
CREDENTIALS_SECRET=change-me-too
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5180
WEB_BASE_URL=http://localhost:5173
SEED_DEMO=true

# ── Platform access (optional) ──────────────────────────────
# Most public endpoints work without credentials. These are optional overrides.
NETEASE_COOKIE=
QQ_COOKIE=
KUWO_COOKIE=
# Apple Music developer token (MusicKit JWT). Required for Apple read/write.
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_STOREFRONT=cn
