# ── Database ────────────────────────────────────────────────
# mysql (production) | sqljs (zero-install local preview)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dukou
DB_PASSWORD=dukou
DB_NAME=dukou
DB_SYNCHRONIZE=true

# ── App ─────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
SEED_DEMO=true

# ── Platform access (optional) ──────────────────────────────
# Some public endpoints work without credentials; these enable
# the read paths that need a logged-in cookie or a developer token.
NETEASE_COOKIE=
QQ_COOKIE=
KUWO_COOKIE=
# Apple Music developer token (MusicKit JWT), required for Apple endpoints
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_STOREFRONT=cn
