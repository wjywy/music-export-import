# ── Database (MySQL 8) ──────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dukou
DB_PASSWORD=dukou
DB_NAME=dukou

# ── App ─────────────────────────────────────────────────────
PORT=3000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
# Encrypts per-user platform tokens (Apple Music). Falls back to JWT_SECRET if empty.
CREDENTIALS_SECRET=change-me-too
WEB_ORIGIN=http://localhost:5173,http://127.0.0.1:5180
WEB_BASE_URL=http://localhost:5173
SEED_DEMO=true

# ── Platform access (optional) ──────────────────────────────
# Most public endpoints work without credentials. These are optional overrides.
NETEASE_COOKIE=
QQ_COOKIE=
KUWO_COOKIE=
# Apple Music 站内直写：任选一种配置；都不配时前端走 Soundiiz 免费导入。
# A) 手工生成一个 MusicKit JWT（ES256，最长 6 个月），填 APPLE_MUSIC_TOKEN；
# B) 配置 Team ID + Key ID + .p8 私钥，服务端自动签发短命 token（推荐）。
#    私钥可直接填（把换行写成 \n），也可用 APPLE_MUSIC_PRIVATE_KEY_PATH 指向文件。
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_PRIVATE_KEY_PATH=
# v1 只支持中国区；账号区号不一致会在授权时拒绝。
APPLE_MUSIC_STOREFRONT=cn
