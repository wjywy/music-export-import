# 生产部署用：复制为 .env.production 后填写，不要提交到 Git
MYSQL_IMAGE=mysql:8.4
# Docker Hub 不可达时可用 npmmirror；Dockerfile 默认官方源
NPM_REGISTRY=https://registry.npmmirror.com
MYSQL_ROOT_PASSWORD=change-root-password
DB_NAME=dukou
DB_USER=dukou
DB_PASSWORD=change-db-password

JWT_SECRET=replace-with-at-least-32-random-characters
# 用于加密网易云 / QQ 登录态；必须固定，换掉会让已连接账号失效
CREDENTIALS_SECRET=replace-with-another-random-secret

# 工具挂载路径；本站最终地址是 https://a2a-platform.com/tool/music/
VITE_BASE=/tool/music/
WEB_ORIGIN=https://a2a-platform.com
WEB_BASE_URL=https://a2a-platform.com/tool/music
WEB_PORT=8080
# 只允许宿主机 nginx 访问；不要直接暴露 8080
WEB_BIND=127.0.0.1

# 可选：读取受限歌单时用，写入走扫码会话，不需要
NETEASE_COOKIE=
# PC 扫码：传统二维码 + 后端会话，不要求用户申请 AppID；browser 为备用官网浏览器模式。
NETEASE_QR_PROVIDER=pc
# 个人 CLI 授权需显式设置 NETEASE_QR_PROVIDER=openapi，并确认账号及接口授权范围。
# H5 授权：回调地址必须在网易云控制台登记，端类型须与应用一致
NETEASE_OPENAPI_REDIRECT_URL=https://a2a-platform.com/tool/music/app/netease-callback
NETEASE_OPENAPI_CLIENT_TYPE=web
NETEASE_OPENAPI_APP_ID=
NETEASE_OPENAPI_APP_KEY=
# 单行 PKCS#8 Base64，或使用 \n 分隔的 RSA PEM；只在服务端配置。
NETEASE_OPENAPI_PRIVATE_KEY=
QQ_COOKIE=

# 官网扫码使用镜像内置的 Chromium
CHROME_PATH=/usr/bin/chromium-browser

# Apple Music 站内直写：任选一种配置；都不配时前端走 Soundiiz 免费导入。
# A) 手工 JWT：APPLE_MUSIC_TOKEN（ES256，最长 6 个月，过期需更换）
# B) 自动签发：Team ID + Key ID + .p8 私钥。私钥里的换行写成 \n，
#    例如 -----BEGIN PRIVATE KEY-----\nMIG...\n-----END PRIVATE KEY-----
# v1 只支持中国区，非 cn 账号会在授权时被拒绝。
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_PRIVATE_KEY=
APPLE_MUSIC_STOREFRONT=cn
