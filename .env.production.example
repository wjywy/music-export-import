# 生产部署用：复制为 .env.production 后填写，不要提交到 Git
MYSQL_IMAGE=mysql:8.4
# Docker Hub 不可达时可用 npmmirror；Dockerfile 默认官方源
NPM_REGISTRY=https://registry.npmmirror.com
MYSQL_ROOT_PASSWORD=change-root-password
DB_NAME=dukou
DB_USER=dukou
DB_PASSWORD=change-db-password

JWT_SECRET=replace-with-at-least-32-random-characters
# 用于加密 Apple Music 用户令牌；缺失时回退到 JWT_SECRET（不建议）
CREDENTIALS_SECRET=replace-with-another-random-secret

WEB_ORIGIN=https://music.example.com
WEB_BASE_URL=https://music.example.com
WEB_PORT=8080

# 可选平台凭证
NETEASE_COOKIE=
QQ_COOKIE=
KUWO_COOKIE=
APPLE_MUSIC_TOKEN=
APPLE_MUSIC_STOREFRONT=cn
