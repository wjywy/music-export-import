{
  "name": "dukou",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "pnpm --parallel --filter @dukou/api --filter @dukou/web dev",
    "dev:api": "pnpm --filter @dukou/api dev",
    "dev:web": "pnpm --filter @dukou/web dev",
    "build": "pnpm --filter @dukou/api build && pnpm --filter @dukou/web build",
    "start:api": "pnpm --filter @dukou/api start",
    "seed": "pnpm --filter @dukou/api seed",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @dukou/api test:unit && pnpm --filter @dukou/api test:e2e && pnpm test:ui",
    "test:unit": "pnpm --filter @dukou/api test:unit",
    "test:e2e": "pnpm --filter @dukou/api test:e2e",
    "test:ui": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
